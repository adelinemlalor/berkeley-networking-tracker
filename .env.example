# ---------------------------------------------------------------------------
# Secure Networking Tracker -- environment variables
#
# Copy this file to .env.local and fill in the values from your Neon project.
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- PUBLIC -----------------------------------------------------------------
# These two are compiled into the browser bundle. That is intentional and safe:
# they are HTTPS endpoints, not credentials. Every contacts row they can reach is
# protected by Row Level Security, so a signed-in user can only ever read or write
# their own rows -- see db/migrations/0001_contacts.sql.

NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-1234.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-1234.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1

# --- SERVER-ONLY ------------------------------------------------------------
# Never prefixed with NEXT_PUBLIC_, never sent to Vercel, never committed.
#
# The deployed app does not use these at all: authentication and data access both
# go through the two public HTTPS endpoints above. DATABASE_URL is used only by
# local tooling -- `npm run db:migrate` and the optional RLS integration test.

DATABASE_URL=postgresql://USER:PASSWORD@ep-example-1234-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- OPTIONAL: two-account privacy test -------------------------------------
# Used only by `npm run verify:rls`, which signs in as both users and proves that
# User A cannot read, update, or delete User B's contacts. Local-only.

TEST_USER_A_EMAIL=user-a@example.com
TEST_USER_A_PASSWORD=replace-me
TEST_USER_B_EMAIL=user-b@example.com
TEST_USER_B_PASSWORD=replace-me
